              {
                "name": "custom-field-public-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Custom Field"
        },
        {
          "info": {
            "name": "Delete Custom Field",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.app.shortcut.com/api/v3/custom-fields/:custom-field-public-id",
            "params": [
              {
                "name": "custom-field-public-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Custom Field"
